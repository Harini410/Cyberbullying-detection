# CyberSafe AI - Environment Configuration Example

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cyberbullying-detection-eta.vercel.app

# Database Configuration (SQLite default; can be postgresql://...)
DATABASE_URL=sqlite:///./cyberbullying.db

# LLM Provider Configuration
# Supported providers: openai, anthropic, ollama, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# RoBERTa Model Settings
ROBERTA_MODEL_NAME=cardiffnlp/twitter-roberta-base-offensive
# CardiffNLP twitter-roberta-base-offensive or roberta-base or local model path
USE_GPU=false
INFERENCE_BATCH_SIZE=1

# Vector Store & RAG Configuration
VECTOR_STORE_TYPE=local
# Options: local, chroma
VECTOR_STORE_DIR=./data/vector_db
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.35

# Privacy and Observability
ANONYMIZE_PII=true
LOG_RAW_PROMPTS=false
RATE_LIMIT_PER_MINUTE=60
